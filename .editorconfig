root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

# Xcode writes the project file with tabs.
[*.pbxproj]
indent_style = tab

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
